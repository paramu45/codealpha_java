public class Room {

    int roomNumber;
    String category;
    int price;
    boolean booked;

    public Room(int roomNumber, String category, int price) {
        this.roomNumber = roomNumber;
        this.category = category;
        this.price = price;
        this.booked = false;
    }

    public void displayRoom() {
        System.out.println("Room No: " + roomNumber +
                " | " + category +
                " | ₹" + price +
                " | " + (booked ? "Booked" : "Available"));
    }
}
