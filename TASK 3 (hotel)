import java.util.ArrayList;

public class Hotel {

    ArrayList<Room> rooms = new ArrayList<>();
    ArrayList<Booking> bookings = new ArrayList<>();

    public Hotel() {
        rooms.add(new Room(101, "Standard", 1000));
        rooms.add(new Room(102, "Standard", 1000));
        rooms.add(new Room(201, "Deluxe", 2000));
        rooms.add(new Room(301, "Suite", 3500));
    }

    
    public void viewRooms() {
        System.out.println("\n--- Room List ---");
        for (Room room : rooms) {
            room.displayRoom();
        }
    }

  
    public void bookRoom(int roomNo, String name) {
        for (Room room : rooms) {
            if (room.roomNumber == roomNo && !room.booked) {
                room.booked = true;

                Booking booking = new Booking(name, room);
                bookings.add(booking);

                FileManager.saveBookings(bookings);

                System.out.println("Booking Successful!");
                System.out.println("Payment Successful: ₹" + room.price);
                return;
            }
        }
        System.out.println("Room not available.");
    }

    
    public void cancelBooking(int roomNo) {
        for (int i = 0; i < bookings.size(); i++) {
            if (bookings.get(i).room.roomNumber == roomNo) {
                bookings.get(i).room.booked = false;
                bookings.remove(i);

                FileManager.saveBookings(bookings);

                System.out.println("Booking Cancelled.");
                return;
            }
        }
        System.out.println("No booking found.");
    }

   
    public void viewBookings() {
        if (bookings.isEmpty()) {
            System.out.println("No bookings found.");
            return;
        }

        for (Booking booking : bookings) {
            booking.displayBooking();
        }
    }
}
